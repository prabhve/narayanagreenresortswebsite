# ==============================================================================
# NARAYANA GREEN RESORTS — ENVIRONMENT VARIABLE CONFIGURATION (.env.example)
# ==============================================================================
# IMPORTANT SECURITY & BUILD NOTES:
# 1. All search verification and analytics variables below are OPTIONAL.
#    The website builds and runs cleanly when they are left blank or omitted.
# 2. Never insert fake verification tokens or dummy analytics IDs (such as
#    "G-XXXXXXXXXX" or "GTM-XXXXXXX") in your active .env.local or deployment
#    settings; leave them empty ("") until you have real production IDs.
# 3. Keep all private API keys and server credentials strictly server-side
#    (NEVER prefix private secrets with NEXT_PUBLIC_).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CANONICAL PRODUCTION SITE URL
# ------------------------------------------------------------------------------
# Official public production origin used for canonical URLs, Open Graph tags,
# sitemap.xml, robots.txt, and Schema.org JSON-LD entity @id URIs.
# Format: "https://narayanaresorts.com" (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://narayanaresorts.com"

# ------------------------------------------------------------------------------
# 2. SEARCH ENGINE WEBMASTER VERIFICATION (OPTIONAL — SERVER-SIDE EVALUATED)
# ------------------------------------------------------------------------------
# When left empty, the corresponding <meta name="google-site-verification"> or
# <meta name="msvalidate.01"> tag is omitted completely from the HTML <head>.
#
# Placeholder format example for Google: "abc123XYZ_google_verification_token"
# Placeholder format example for Bing:   "1234567890ABCDEF1234567890ABCDEF"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# 3. ANALYTICS & TAG MANAGEMENT (OPTIONAL — ZERO DUPLICATE PAGEVIEWS)
# ------------------------------------------------------------------------------
# Leave both empty to disable all tracking scripts.
#
# HOW DUPLICATE PAGEVIEWS ARE PREVENTED:
# - Option A (Recommended if using GTM): Set GTM_ID (or NEXT_PUBLIC_GTM_ID).
#   When a valid GTM container ID is configured, ONLY the GTM container script
#   is loaded so you can manage GA4 tags inside GTM without loading a duplicate
#   standalone gtag.js installation.
# - Option B (Standalone GA4 without GTM): Leave GTM_ID empty and set
#   GA4_MEASUREMENT_ID (or NEXT_PUBLIC_GA4_MEASUREMENT_ID).
#
# Placeholder format example for GA4: "G-1A2B3C4D5E"
# Placeholder format example for GTM: "GTM-A1B2C3D"
GA4_MEASUREMENT_ID=""
GTM_ID=""
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_ID=""

# ------------------------------------------------------------------------------
# 4. SERVER-ONLY PRIVATE CREDENTIALS (NEVER EXPOSE WITH NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Place any future server-only API keys or secrets below without NEXT_PUBLIC_.
# (No third-party secrets are required for the current direct enquiry workflow.)
